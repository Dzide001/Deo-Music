<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme for API 26-28. android:Theme.DeviceDefault.DayNight only exists
      from API 29, so referencing it here failed to inflate on Android 8.0-9.0.
      The DayNight variant is applied via values-v29.

      windowActionBar/windowNoTitle are off because the app has never used the
      platform action bar: DeviceDefault brings one in by default, and it was
      drawing a band with the app label above the Compose header on every screen —
      including the full-bleed player, which is supposed to reach the status bar.
    -->
    <style name="Theme.MusicPlayer" parent="android:Theme.DeviceDefault">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
